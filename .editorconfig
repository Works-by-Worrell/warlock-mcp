# EditorConfig configuration for Python projects
# Reference: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
# Standard Python indentation (PEP 8) and formatting rules matched with Ruff
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
# YAML formatting standards
indent_style = space
indent_size = 2

[*.json]
# JSON formatting standards
indent_style = space
indent_size = 2

[*.md]
# Markdown formatting standards
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
