#!/bin/sh

# Get the path to the commit message temp file
COMMIT_MSG_FILE=$1
# Read the first line of the commit message (the subject line)
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow automatic git merge commits to bypass this validation
case "$COMMIT_MSG" in
  Merge*)
    exit 0
    ;;
esac

# Regex to check if subject line ends with a space and (#<number>) or (Closes #<number>)
if ! echo "$COMMIT_MSG" | grep -qE "^.* \((Closes )?#[0-9]+\)$"; then
  echo "Git Commit Rejected: Message must end with an issue number in parentheses (e.g. '(#3)' or '(Closes #3)')" >&2
  echo "Your message was: '$COMMIT_MSG'" >&2
  exit 1
fi
